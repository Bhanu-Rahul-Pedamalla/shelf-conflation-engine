 "sql": {
  "planned_facing": "select p.store_id, p.aisle, p.shelf, p.position, k as facing, p.before + k as slot, p.code as planned_code from (select *, sum(facings) over (partition by store_id, aisle, shelf order by position rows between unbounded preceding and current row) - facings as before from planogram) p, generate_series(1, p.facings) t(k)",
  "realogram": "select f.store_id, f.aisle, f.shelf, f.position, f.facing, f.slot, f.planned_code, c1.label as planned_label, r.spot_id, r.product_code, r.product_label, case when r.spot_id is null then 'never read' when r.status = 'contested' then 'contested' when r.product_code is null then 'open' when r.catalog_status = 'discontinued in v2, still on the shelf' and r.product_code = f.planned_code then 'as planned, catalog dropped it' when r.product_code = f.planned_code then 'as planned' when r.v1_code = f.planned_code then 'as planned, new size' else 'different product' end as verdict, r.catalog_status, r.method, r.confidence_rank, r.reads, r.supporting, r.n_open, r.first_seen, r.last_seen, r.last_read, case when r.spot_id is null then null else substr(r.last_read, 1, 10) = l.latest end as read_on_latest_walk, case when r.product_code is null then null else substr(r.last_seen, 1, 10) = l.latest end as seen_on_latest_walk, r.open_reads, r.candidates from planned_facing f left join records r using (store_id, aisle, shelf, slot) left join (select store_id, max(substr(last_read, 1, 10)) as latest from records group by 1) l on l.store_id = f.store_id left join catalog c1 on c1.code = f.planned_code and c1.version = 'v1' order by f.store_id, f.aisle, f.shelf, f.slot",
  "compliance": "select store_id, aisle, shelf, count(*) as planned_facings, count(*) filter (where verdict in ('as planned', 'as planned, new size', 'as planned, catalog dropped it')) as compliant, count(*) filter (where verdict = 'as planned') as as_planned, count(*) filter (where verdict = 'as planned, new size') as new_size, count(*) filter (where verdict = 'as planned, catalog dropped it') as catalog_dropped, count(*) filter (where verdict = 'different product') as different_product, count(*) filter (where verdict = 'contested') as contested, count(*) filter (where verdict = 'open') as open, count(*) filter (where verdict = 'never read') as never_read, count(*) filter (where seen_on_latest_walk = false) as not_seen_on_latest_walk from realogram group by all order by all"
 },
 "checks": {
  "every planned facing has exactly one realogram row": true,
  "every record stands on exactly one planned facing": true,
  "the verdicts add up to the planned facings": true,
  "the shelf rows add up to the verdicts": true,
  "a compliant row's product is the planned code, or its successor, or the dropped product the planogram still plans": true,
  "an open row has no product and every one of its reads open": true,
  "a never-read row has no record": true
 }
}
